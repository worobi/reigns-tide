SITE_DOMAIN=reignstide.org
CMS_DOMAIN=cms.reignstide.org
SHOP_DOMAIN=shop.reignstide.org
CADDY_EMAIL=you@example.com

DIRECTUS_SECRET=replace-with-a-long-random-secret
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-this-password

# Use the exact public origins once domains are live.
CORS_ORIGIN=https://reignstide.org,https://www.reignstide.org
PUBLIC_URL=https://cms.reignstide.org

# Private backend-only values for story spam protection.
# Never put TURNSTILE_SECRET in site/assets/config.js.
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=reignstide.org,www.reignstide.org

# Private backend-only value for the Printful product feed.
STORE_ENABLED=false
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=

# WordPress/WooCommerce shop values.
WORDPRESS_DB_NAME=reigns_tide_shop
WORDPRESS_DB_USER=reigns_tide_shop
WORDPRESS_DB_PASSWORD=change-this-password
WORDPRESS_DB_ROOT_PASSWORD=change-this-root-password
WORDPRESS_AUTH_KEY=replace-with-random-secret
WORDPRESS_SECURE_AUTH_KEY=replace-with-random-secret
WORDPRESS_LOGGED_IN_KEY=replace-with-random-secret
WORDPRESS_NONCE_KEY=replace-with-random-secret
WORDPRESS_AUTH_SALT=replace-with-random-secret
WORDPRESS_SECURE_AUTH_SALT=replace-with-random-secret
WORDPRESS_LOGGED_IN_SALT=replace-with-random-secret
WORDPRESS_NONCE_SALT=replace-with-random-secret
